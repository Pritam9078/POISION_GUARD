# ── runtime ──
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# CORS_ORIGINS=https://poisonguard.app,https://admin.poisonguard.app   # overrides FRONTEND_URL/ADMIN_URL allowlist
TRUST_PROXY=false
LOG_LEVEL=info

# ── data ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poisonguard
# inline = jobs run in the API process (dev). queue = BullMQ; run `npm run worker` too.
JOB_MODE=inline
REDIS_URL=redis://localhost:6379

# ── secrets (REQUIRED in production) ──
SESSION_SECRET=change-me-to-64-random-chars-change-me-to-64-random-chars
ENCRYPTION_KEY=                     # 32 bytes base64:  openssl rand -base64 32
COOKIE_SECURE=false                 # true behind HTTPS
SESSION_TTL_HOURS=168
STAFF_SESSION_TTL_HOURS=8

# ── chains (read-only RPC; a chain without RPC is reported as offline, never faked) ──
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
BSC_RPC_URL=
SEPOLIA_RPC_URL=
SCAN_LOG_BLOCK_RANGE=50000          # RPC-only history window (blocks)
SCAN_LOG_CHUNK=10000
SCAN_TIMEOUT_MS=60000
# Optional full-history indexer (Etherscan V2 multichain, one key)
ETHERSCAN_API_KEY=

# ── graph (optional) ──
TIGERGRAPH_HOST=                    # e.g. https://<cluster>.i.tgcloud.io
TIGERGRAPH_GRAPH_NAME=PoisonGuard
TIGERGRAPH_TOKEN=

# ── AI / RAG (optional; "none" = assistant returns citations only) ──
AI_PROVIDER=none                    # none | mock | anthropic | openai
AI_API_KEY=
AI_MODEL=                           # required for anthropic/openai
EMBEDDING_PROVIDER=none             # none | mock | openai   (pgvector extension required)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ── billing (optional) ──
DODO_API_KEY=
DODO_WEBHOOK_SECRET=                # whsec_…
DODO_ENVIRONMENT=test_mode          # test_mode | live_mode
DODO_RETURN_URL=

# ── email ──
EMAIL_PROVIDER=console              # console (logs only) | resend | none
EMAIL_API_KEY=
EMAIL_FROM=PoisonGuard <no-reply@poisonguard.app>

# ── proof anchoring (optional; platform-owned key, never a customer key) ──
PROOF_REGISTRY_CHAIN_ID=
PROOF_REGISTRY_ADDRESS=
PROOF_ANCHOR_PRIVATE_KEY=

# ── webhooks ──
WEBHOOK_ALLOW_PRIVATE_URLS=false    # true only for local testing
