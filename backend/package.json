{
  "name": "poisonguard-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PoisonGuard API: scanner, Guard workspace, authorization engine, audit and admin APIs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/workers/index.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "staff:create": "node scripts/create-staff.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test --config=tests/playwright.config.js",
    "test:api": "node tests/helpers/run-api-tests.js",
    "test:integration": "node tests/helpers/run-integration-tests.js",
    "test:security": "node tests/helpers/run-security-tests.js",
    "test:visual": "playwright test --config=tests/playwright.config.js --project=desktop-chrome --project=mobile",
    "test:all": "node tests/helpers/run-all-tests.js",
    "test:cleanup": "node tests/cleanup/cleanup.js",
    "test:reset": "node tests/cleanup/reset.js",
    "test:report": "playwright show-report tests/reports/html",
    "test:smoke": "playwright test tests/e2e/public-pages --config=tests/playwright.config.js",
    "test:admin": "playwright test tests/e2e/admin --config=tests/playwright.config.js --project=admin-portal",
    "test:user": "playwright test tests/e2e/user-dashboard --config=tests/playwright.config.js",
    "test:blockchain:local": "node tests/integration/blockchain/local.test.js",
    "test:blockchain:sepolia": "node tests/integration/blockchain/sepolia.test.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@huggingface/transformers": "^3.8.1",
    "bullmq": "^5.81.5",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "pino-pretty": "^13.2.0"
  }
}
